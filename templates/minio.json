{
  "schemaVersion": 1,
  "slug": "minio",
  "name": "MinIO",
  "category": "storage",
  "icon": "template",
  "description": "S3-compatible object storage server.",
  "image": "minio/minio",
  "tag": "RELEASE.2025-09-07T16-13-09Z",
  "ports": [
    {
      "container": 9000,
      "label": "S3 API",
      "defaultHost": 9000
    },
    {
      "container": 9001,
      "label": "Console",
      "defaultHost": 9001
    }
  ],
  "env": [
    {
      "key": "MINIO_ROOT_USER",
      "label": "Root user",
      "default": "minioadmin"
    },
    {
      "key": "MINIO_ROOT_PASSWORD",
      "label": "Root password",
      "required": true,
      "secret": true,
      "description": "Minimum 8 characters."
    }
  ],
  "volumes": [
    {
      "container": "/data",
      "label": "Data"
    }
  ],
  "restartPolicy": "unless-stopped",
  "command": [
    "server",
    "/data",
    "--console-address",
    ":9001"
  ],
  "notes": "The S3 API is on 9000 and the web console on 9001. MINIO_ROOT_PASSWORD must be at least 8 characters.",
  "docsUrl": "https://min.io/docs/minio/container/index.html"
}
